from nltk.stem import PorterStemmer

# Create Porter Stemmer object
stemmer = PorterStemmer()

# List of words
words = [
    "playing",
    "played",
    "plays",
    "connected",
    "connection",
    "running",
    "studies",
    "happily"
]

print("Original Word\tStemmed Word")
print("------------------------------")

# Apply stemming
for word in words:
    stem = stemmer.stem(word)
    print(word, "\t\t", stem)
